---
import Layout from "../layouts/Layout.astro";
import  ProfileCard  from "../components/ProfileCard.astro";
import {email} from "astro:schema";

const profil = {
nama: "Hana Insomnia",
kelas: 'XI RPL',
bio: 'amnesia',
foto: './0d4a88f5a1e7062f4ce3151ba4b05395.jpg',
keahlian: ['Android Devolopa','Fullstack Devolopa'],
github: 'https://github.com/Rid-67',
email: 'ayu@gmail.com'
